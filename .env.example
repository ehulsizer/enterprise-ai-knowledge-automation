APP_API_KEY=local-demo-key-change-before-hosting
ENTERPRISE_API_KEY=local-enterprise-key-change-before-hosting
API_BASE_URL=http://127.0.0.1:8000
# fastembed downloads BAAI/bge-small-en-v1.5 on first use; offline is lexical demo mode.
EMBEDDING_MODE=fastembed
QDRANT_PATH=data/qdrant
ENTERPRISE_DB_PATH=data/enterprise.sqlite3
MODEL_CACHE_PATH=data/models
SAMPLE_DOCUMENTS_PATH=samples
EMBEDDING_THREADS=1
MAX_CONCURRENT_QUERIES=4
# QDRANT_URL=https://your-cluster.cloud.qdrant.io
# QDRANT_API_KEY=
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
